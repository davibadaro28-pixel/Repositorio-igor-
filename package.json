{
  "name": "lacos-de-mae-sistema",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de gestão (PDV, delivery, cardápio digital, estoque, financeiro) da Laços de Mãe – Bolos e Doces",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --no-warnings=ExperimentalWarning --watch server/index.js",
    "dev:web": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "start": "node --no-warnings=ExperimentalWarning server/index.js",
    "demo": "node --no-warnings=ExperimentalWarning server/demo.js",
    "test": "node --no-warnings=ExperimentalWarning --test server/test/*.test.js"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.540.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.1.0"
  }
}
